# ------------------------------------------------------------------
# Jesus The Counselor Cavite — Environment Variables (example)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# --- App ---
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_PORT=4000

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jtc_cavite?schema=public"

# --- Authentication ---
# Generate strong secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_long_random_secret

# --- Initial Super Admin (used by prisma/seed.ts) ---
SEED_ADMIN_EMAIL=admin@jtccavite.org
SEED_ADMIN_PASSWORD=ChangeMe_Strong123!
SEED_ADMIN_NAME=Site Administrator

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Cookies ---
# Domain the auth cookies are scoped to. Leave BLANK for localhost/dev.
# In production set to your site domain, e.g. jtccavite.org
COOKIE_DOMAIN=

# --- Media / Storage (placeholder — swap for S3/Cloudinary later) ---
MEDIA_PROVIDER=local
MEDIA_LOCAL_DIR=server/uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Giving / Payments (placeholder integration) ---
# GIVING_PROVIDER=stripe
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Email (for prayer/contact notifications — placeholder) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Jesus The Counselor Cavite <no-reply@jtccavite.org>"

# --- Frontend build-time (Vite exposes only VITE_* to client) ---
VITE_API_BASE_URL=/api
VITE_SITE_URL=http://localhost:5173
